# Copie este arquivo para .env.local e preencha com as credenciais reais.
# Não comite o .env.local — ele já está no .gitignore.

# ─── Supabase ──────────────────────────────────────────────────────────────
# Encontradas em: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...sua-anon-key
# Apenas no servidor, necessária para criar usuários em Gestão de Acessos.
# Nunca use prefixo NEXT_PUBLIC_ nesta chave.
SUPABASE_SERVICE_ROLE_KEY=

# ─── E-mail (Zoho SMTP, usado por /api/notify) ────────────────────────────
ZOHO_EMAIL=remetente@suaempresa.com.br
ZOHO_PASSWORD=senha-de-app-do-zoho

# ─── URL pública do site ───────────────────────────────────────────────────
# Usado em templates de email e links em redirects.
# Em dev pode deixar http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://seu-site.vercel.app
